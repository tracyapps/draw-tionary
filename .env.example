# From the Discord Developer Portal → your app → General Information
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=

# Bot tab → Token. Needed to post drawings into the channel.
DISCORD_BOT_TOKEN=

# Your test server's id. Guild commands register instantly;
# leave blank to register globally (takes up to an hour).
DISCORD_GUILD_ID=

# Where the server is reachable from the internet. During development this
# is your tunnel URL (cloudflared / ngrok), not localhost — Discord has to
# be able to reach it.
PUBLIC_URL=https://your-tunnel.example.com
PORT=3000

# Optional: where the SQLite file lives. Defaults to ./draw-tionary.db
DB_FILE=

# Set to 1 when the pages run inside a Discord Activity iframe. Switches the
# viewer cookie to SameSite=None; Secure; Partitioned, which is the only thing
# browsers send in a third-party frame. Requires PUBLIC_URL to be https.
EMBEDDED_ACTIVITY=
