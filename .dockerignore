# Everything here is either rebuilt in the image, irrelevant to the server, or
# far too large to ship. The art folder alone is ~50 MB of Affinity source.

node_modules/
.git/
.github/

# Regenerated by `npm run build` during the image build
spike/bundle.js
app/bundle.js

# Never bake secrets or a local database into an image
.env
*.db
*.db-wal
*.db-shm

# Design source. The server has no use for any of it.
art/
.DS_Store

# The device-testing prototypes are never served. tools/ has to stay, because
# the image build runs `npm run build` out of it to generate app/bundle.js.
spike/

# Test-only tooling. Tests belong in CI against the repo, not in a production
# container, and e2e.js would otherwise ship a fake Discord public key.
tools/smoke.js
tools/e2e.js
tools/schema-check.js
tools/build-art-templates.js

*.md
!bot/SETUP.md
